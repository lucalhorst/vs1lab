# Normalize every text file to LF in the repository and in the worktree.
# This takes precedence over core.autocrlf.
* text=auto eol=lf

# Explicitly binary (never converted)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.lnk binary
